name: Build Android APK

on:
  workflow_dispatch:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    defaults:
      run:
        shell: bash
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: Setup .NET 10
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'

      - name: Find project file
        run: |
          PROJ=$(find src -name '*.csproj' | head -n 1)
          echo "Using project: $PROJ"
          echo "PROJ=$PROJ" >> "$GITHUB_ENV"

      - name: Install MAUI Android workload
        run: dotnet workload install maui-android

      - name: Install Android SDK components
        run: |
          dotnet build "$PROJ" -f net10.0-android \
            -t:InstallAndroidDependencies \
            -p:AndroidSdkDirectory="$HOME/android-sdk" \
            -p:AcceptAndroidSDKLicenses=True

      - name: Build APK
        run: |
          dotnet publish "$PROJ" -f net10.0-android -c Release \
            -p:AndroidPackageFormat=apk \
            -p:RuntimeIdentifier=android-arm64 \
            -p:PublishTrimmed=false \
            -p:RunAOTCompilation=false \
            -p:AndroidSdkDirectory="$HOME/android-sdk" \
            2>&1 | tee build.log

      - name: Collect APK
        run: |
          mkdir -p out
          find src -path '*Release*' -name '*.apk' -exec cp {} out/ \;
          ls -la out
          test -n "$(ls -A out)"

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: MobileI2V-apk
          path: out/*.apk

      - name: Upload build log
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: build-log
          path: build.log
